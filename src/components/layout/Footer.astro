---
import { SITE, lien } from '~/data/site';
const classeLien = 'hover:text-indigo-700 underline underline-offset-2 hover:decoration-2 dark:hover:text-indigo-300';
---

<footer class="mt-20 border-t border-slate-200 bg-slate-50 dark:border-slate-800 dark:bg-slate-900/60">
  <div
    class="mx-auto flex max-w-7xl flex-col gap-6 px-4 py-10 text-sm text-slate-600 sm:px-6 md:flex-row md:justify-between lg:px-8 dark:text-slate-400"
  >
    <div class="max-w-md space-y-2">
      <p class="font-bold text-slate-900 dark:text-white">{SITE.nom}</p>
      <p>{SITE.titre}.</p>
      <p>{SITE.avertissement}</p>
    </div>
    <nav aria-label="Liens de pied de page">
      <ul class="space-y-2">
        <li><a class={classeLien} href={lien('/programme/')}>Programme complet</a></li>
        <li><a class={classeLien} href={lien('/progression/')}>Ma progression et mes badges</a></li>
        <li>
          <a class={classeLien} href="https://create.roblox.com/docs" rel="noopener">Documentation officielle Roblox ↗</a>
        </li>
      </ul>
    </nav>
  </div>
</footer>
