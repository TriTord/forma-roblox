---
/** Bascule clair/sombre. Le thème initial est posé par le script inline de BaseLayout (sans flash). */
---

<button
  type="button"
  class="inline-flex size-10 items-center justify-center rounded-lg text-slate-600 hover:bg-slate-100 hover:text-slate-900 dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-white"
  data-bascule-theme
  data-testid="theme-toggle"
  aria-label="Activer le thème sombre"
>
  <svg class="size-5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"
    ><path stroke-linecap="round" stroke-linejoin="round" d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path></svg
  >
  <svg class="hidden size-5 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"
    ><circle cx="12" cy="12" r="4"></circle><path
      stroke-linecap="round"
      d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg
  >
</button>

<script>
  const CLE = 'forma-roblox:theme';
  const racine = document.documentElement;
  const boutons = document.querySelectorAll<HTMLButtonElement>('[data-bascule-theme]');

  function lirePreference(): string | null {
    try {
      return localStorage.getItem(CLE);
    } catch {
      return null;
    }
  }

  function appliquer(sombre: boolean) {
    racine.classList.toggle('dark', sombre);
    boutons.forEach((b) => b.setAttribute('aria-label', sombre ? 'Activer le thème clair' : 'Activer le thème sombre'));
  }

  appliquer(racine.classList.contains('dark'));

  boutons.forEach((b) =>
    b.addEventListener('click', () => {
      const sombre = !racine.classList.contains('dark');
      appliquer(sombre);
      try {
        localStorage.setItem(CLE, sombre ? 'sombre' : 'clair');
      } catch {
        /* préférence non mémorisée (stockage indisponible) */
      }
    }),
  );

  // Suit le thème du système tant que l'utilisateur n'a pas choisi explicitement.
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
    if (!lirePreference()) appliquer(e.matches);
  });
</script>
