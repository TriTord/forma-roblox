---
import { SITE, lien } from '~/data/site';
import Recherche from './Recherche.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  /** Affiche le bouton « Sommaire » (pages avec barre latérale, sous 1024 px). */
  boutonSommaire?: boolean;
}
const { boutonSommaire = false } = Astro.props;
const chemin = Astro.url.pathname;
const liens = [
  { href: lien('/programme/'), texte: 'Programme' },
  { href: lien('/progression/'), texte: 'Ma progression' },
];
---

<header class="sticky top-0 z-40 border-b border-slate-200 bg-white/90 backdrop-blur dark:border-slate-800 dark:bg-slate-950/90">
  <a
    href="#contenu"
    class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-3 focus:z-50 focus:rounded-lg focus:bg-indigo-600 focus:px-4 focus:py-2 focus:text-white"
    >Aller au contenu</a
  >
  <div class="mx-auto flex h-16 max-w-7xl items-center gap-2 px-4 sm:gap-4 sm:px-6 lg:px-8">
    {
      boutonSommaire && (
        <button
          type="button"
          class="inline-flex size-10 items-center justify-center rounded-lg text-slate-700 hover:bg-slate-100 lg:hidden dark:text-slate-200 dark:hover:bg-slate-800"
          data-ouvrir-sommaire
          data-testid="sidebar-toggle"
          aria-controls="sommaire"
          aria-expanded="false"
          aria-label="Ouvrir le sommaire"
        >
          <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      )
    }
    <a href={lien('/')} class="flex items-center gap-2 font-extrabold tracking-tight text-slate-900 dark:text-white" data-testid="logo">
      <img src={lien('/favicon.svg')} alt="" width="32" height="32" class="size-8" />
      <span class="max-sm:sr-only">{SITE.nom}</span>
    </a>
    <nav aria-label="Navigation principale" class="ml-2 hidden md:block">
      <ul class="flex gap-1">
        {
          liens.map((l) => (
            <li>
              <a
                href={l.href}
                class="rounded-lg px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100 hover:text-slate-900 aria-[current=page]:text-indigo-700 dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-white dark:aria-[current=page]:text-indigo-300"
                aria-current={chemin.startsWith(l.href) ? 'page' : undefined}
              >
                {l.texte}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="ml-auto flex items-center gap-1 sm:gap-2">
      <Recherche />
      <a
        href={lien('/progression/')}
        class="inline-flex size-10 items-center justify-center rounded-lg text-slate-600 hover:bg-slate-100 md:hidden dark:text-slate-300 dark:hover:bg-slate-800"
        aria-label="Ma progression"
      >
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8 21h8M12 17v4M7 4h10v5a5 5 0 0 1-10 0V4ZM7 6H4a3 3 0 0 0 3 4m10-4h3a3 3 0 0 1-3 4" />
        </svg>
      </a>
      <ThemeToggle />
    </div>
  </div>
</header>
