---
import BarreProgression from '~/components/layout/BarreProgression.astro';
import FilAriane from '~/components/layout/FilAriane.astro';
import { lien } from '~/data/site';
import CoursLayout from '~/layouts/CoursLayout.astro';
import { formaterDuree, getModules, type ModuleAvecLecons } from '~/lib/cours';

export async function getStaticPaths() {
  const modules = await getModules();
  return modules.map((module) => ({ params: { module: module.numero }, props: { module } }));
}

interface Props {
  module: ModuleAvecLecons;
}
const { module } = Astro.props;
const modules = await getModules();
const index = modules.findIndex((m) => m.numero === module.numero);
const precedent = modules[index - 1];
const suivant = modules[index + 1];
---

<CoursLayout titre={`Module ${module.numero} : ${module.titre}`} description={module.description} moduleActif={module.numero}>
  <div class="mx-auto max-w-3xl">
    <FilAriane elements={[{ texte: 'Programme', href: lien('/programme/') }, { texte: `Module ${module.numero}` }]} />

    <header data-pagefind-body data-testid="module-entete">
      <p class="text-sm font-semibold text-indigo-700 dark:text-indigo-300">Module {module.numero} · {module.lecons.length} leçon{module.lecons.length > 1 ? "s" : ""}</p>
      <h1 class="mt-2 flex items-start gap-3 text-3xl font-extrabold tracking-tight text-balance text-slate-900 sm:text-4xl dark:text-white">
        <span aria-hidden="true">{module.emoji}</span>
        <span>{module.titre}</span>
      </h1>
      <p class="mt-4 text-lg text-slate-600 dark:text-slate-300">{module.description}</p>

      <section class="mt-8 rounded-2xl border border-slate-200 p-5 dark:border-slate-800" aria-labelledby="objectifs-module">
        <h2 id="objectifs-module" class="font-bold text-slate-900 dark:text-white">À la fin de ce module, tu sauras :</h2>
        <ul class="mt-3 list-disc space-y-1 pl-5 text-slate-700 marker:text-indigo-500 dark:text-slate-300">
          {module.objectifs.map((o) => <li>{o}</li>)}
        </ul>
      </section>
    </header>

    <BarreProgression portee="module" module={module.numero} libelle={`Progression dans le module ${module.numero}`} class="mt-8" />

    <section class="mt-10" aria-labelledby="lecons-titre">
      <div class="flex items-baseline justify-between gap-4">
        <h2 id="lecons-titre" class="text-xl font-bold text-slate-900 dark:text-white">Les leçons</h2>
        {module.duree > 0 && <p class="text-sm text-slate-600 dark:text-slate-400">≈ {formaterDuree(module.duree)} au total</p>}
      </div>

      {
        module.lecons.length === 0 ? (
          <p class="mt-4 rounded-xl border border-dashed border-slate-300 p-6 text-slate-600 dark:border-slate-700 dark:text-slate-400" data-testid="module-vide">
            Les leçons de ce module sont en préparation. Reviens bientôt !
          </p>
        ) : (
          <ol class="mt-4 space-y-3" data-testid="module-lecons">
            {module.lecons.map((l, i) => (
              <li>
                <a
                  href={l.url}
                  class="group flex items-start gap-4 rounded-xl border border-slate-200 p-4 hover:border-indigo-500 hover:bg-indigo-50/40 dark:border-slate-800 dark:hover:border-indigo-400 dark:hover:bg-indigo-950/30"
                  data-statut-lecon={l.id}
                >
                  <span class="grid size-9 shrink-0 place-items-center rounded-lg bg-slate-100 font-bold tabular-nums text-slate-700 dark:bg-slate-800 dark:text-slate-200">
                    {i + 1}
                  </span>
                  <span class="min-w-0 flex-1">
                    <span class="block font-semibold text-slate-900 group-hover:text-indigo-700 dark:text-white dark:group-hover:text-indigo-300">
                      {l.entry.data.titre}
                      <span class="sr-only" data-statut-texte />
                    </span>
                    <span class="mt-1 block text-sm text-slate-600 dark:text-slate-400">{l.entry.data.description}</span>
                    <span class="mt-2 block text-xs text-slate-500 dark:text-slate-400">⏱️ {formaterDuree(l.entry.data.duree)}</span>
                  </span>
                  <span class="pastille mt-1" aria-hidden="true">✓</span>
                </a>
              </li>
            ))}
          </ol>
        )
      }
    </section>

    <section class="mt-10 rounded-2xl border border-amber-300 bg-amber-50 p-6 dark:border-amber-700 dark:bg-amber-950/30" aria-labelledby="examen-titre">
      <h2 id="examen-titre" class="text-xl font-bold text-slate-900 dark:text-white">🏁 Examen du module</h2>
      {
        module.examen ? (
          <>
            <p class="mt-2 text-slate-700 dark:text-slate-300">
              {module.examen.data.questions.length} questions · réussite à partir de {module.examen.data.seuil} % · badge « {module.badge.emoji} {module.badge.nom} » à la clé.
            </p>
            <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">
              Ton meilleur résultat : <span data-resultat-examen={module.numero}>Pas encore tenté</span>
            </p>
            <a href={module.urlExamen} class="bouton bouton-primaire mt-4" data-testid="lien-examen">
              Passer l’examen
            </a>
          </>
        ) : (
          <p class="mt-2 text-slate-700 dark:text-slate-300">L’examen de ce module est en préparation.</p>
        )
      }
    </section>

    <nav aria-label="Modules voisins" class="mt-12 flex flex-wrap justify-between gap-4 text-sm font-semibold">
      {precedent ? <a class="text-indigo-700 underline underline-offset-2 hover:decoration-2 dark:text-indigo-300" href={precedent.url}>← Module {precedent.numero} : {precedent.titreCourt}</a> : <span />}
      {suivant && <a class="text-indigo-700 underline underline-offset-2 hover:decoration-2 dark:text-indigo-300" href={suivant.url}>Module {suivant.numero} : {suivant.titreCourt} →</a>}
    </nav>
  </div>
</CoursLayout>
