---
import BarreProgression from '~/components/layout/BarreProgression.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { formaterDuree, getLecons, getModules } from '~/lib/cours';

const modules = await getModules();
const lecons = await getLecons();
const dureeTotale = modules.reduce((t, m) => t + m.duree, 0);
---

<BaseLayout titre="Programme complet" description="Le programme détaillé de la formation : 12 modules, leurs leçons et leurs examens.">
  <main class="mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:px-8">
    <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl dark:text-white">Programme complet</h1>
    <p class="mt-3 text-lg text-slate-600 dark:text-slate-300">
      {modules.length} modules · {lecons.length} leçon{lecons.length > 1 ? 's' : ''} publiée{lecons.length > 1 ? 's' : ''}
      {dureeTotale > 0 && <> · ≈ {formaterDuree(dureeTotale)} de contenu</>}
    </p>
    <BarreProgression portee="globale" libelle="Progression dans la formation" class="mt-6" />

    <ol class="mt-10 space-y-6" data-testid="programme-modules">
      {
        modules.map((m) => (
          <li class="rounded-2xl border border-slate-200 p-6 dark:border-slate-800">
            <div class="flex flex-wrap items-start gap-4">
              <span class="grid size-12 shrink-0 place-items-center rounded-xl bg-indigo-50 text-2xl dark:bg-indigo-950" aria-hidden="true">
                {m.emoji}
              </span>
              <div class="min-w-0 flex-1">
                <p class="text-sm font-bold text-indigo-700 dark:text-indigo-300">Module {m.numero}</p>
                <h2 class="text-xl font-bold text-slate-900 dark:text-white">
                  <a href={m.url} class="hover:text-indigo-700 underline underline-offset-2 hover:decoration-2 dark:hover:text-indigo-300">{m.titre}</a>
                </h2>
                <p class="mt-1 text-slate-600 dark:text-slate-400">{m.description}</p>
              </div>
            </div>
            {m.lecons.length > 0 ? (
              <ol class="mt-5 space-y-1 border-t border-slate-200 pt-4 dark:border-slate-800">
                {m.lecons.map((l, i) => (
                  <li>
                    <a
                      href={l.url}
                      class="flex items-center gap-3 rounded-lg px-2 py-1.5 text-slate-700 hover:bg-slate-100 hover:text-slate-900 dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-white"
                      data-statut-lecon={l.id}
                    >
                      <span class="pastille" aria-hidden="true">✓</span>
                      <span class="w-6 shrink-0 text-sm tabular-nums text-slate-500 dark:text-slate-400">{i + 1}.</span>
                      <span class="flex-1">
                        {l.entry.data.titre}
                        <span class="sr-only" data-statut-texte />
                      </span>
                      <span class="shrink-0 text-xs text-slate-500 dark:text-slate-400">{formaterDuree(l.entry.data.duree)}</span>
                    </a>
                  </li>
                ))}
              </ol>
            ) : (
              <p class="mt-5 border-t border-slate-200 pt-4 text-sm italic text-slate-600 dark:border-slate-800 dark:text-slate-400">Leçons en préparation.</p>
            )}
            <p class="mt-3 flex flex-wrap gap-x-6 gap-y-2 text-sm font-semibold">
              <a href={m.url} class="text-indigo-700 underline underline-offset-2 hover:decoration-2 dark:text-indigo-300">Voir le module →</a>
              {m.examen && (
                <a href={m.urlExamen} class="text-indigo-700 underline underline-offset-2 hover:decoration-2 dark:text-indigo-300">
                  🏁 Examen ({m.examen.data.questions.length} questions)
                </a>
              )}
            </p>
          </li>
        ))
      }
    </ol>
  </main>
</BaseLayout>
