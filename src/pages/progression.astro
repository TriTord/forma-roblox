---
import BarreProgression from '~/components/layout/BarreProgression.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getModules } from '~/lib/cours';

const modules = await getModules();
---

<BaseLayout titre="Ma progression" description="Ta progression dans la formation, tes résultats d’examens et tes badges.">
  <main class="mx-auto max-w-5xl px-4 py-12 sm:px-6 lg:px-8">
    <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl dark:text-white">Ma progression</h1>
    <p class="mt-3 max-w-2xl text-slate-600 dark:text-slate-300">
      Ta progression est enregistrée <strong>uniquement dans ce navigateur</strong>, sur cet appareil. Aucun compte, aucune donnée
      envoyée.
    </p>

    <p
      class="mt-6 rounded-xl border border-amber-300 bg-amber-50 p-4 text-amber-900 dark:border-amber-700 dark:bg-amber-950/40 dark:text-amber-200"
      role="alert"
      data-alerte-stockage
      data-testid="alerte-stockage"
      hidden
    >
      ⚠️ Ton navigateur bloque le stockage local (navigation privée ou cookies désactivés) : ta progression sera perdue en quittant la
      page.
    </p>

    <section class="mt-8 rounded-2xl border border-slate-200 p-6 dark:border-slate-800" aria-labelledby="globale-titre">
      <h2 id="globale-titre" class="text-xl font-bold text-slate-900 dark:text-white">Progression globale</h2>
      <BarreProgression portee="globale" libelle="Progression dans la formation" class="mt-4" />
      <a href="#" class="mt-4 inline-flex font-semibold text-indigo-700 hover:underline dark:text-indigo-300" data-reprendre hidden>
        ↻ Continuer : <span class="ml-1" data-reprendre-titre></span>
      </a>
    </section>

    <section class="mt-8" aria-labelledby="modules-titre">
      <h2 id="modules-titre" class="text-xl font-bold text-slate-900 dark:text-white">Par module</h2>
      <ul class="mt-4 grid gap-4 md:grid-cols-2" data-testid="progression-modules">
        {
          modules.map((m) => (
            <li class="rounded-2xl border border-slate-200 p-5 dark:border-slate-800">
              <a href={m.url} class="font-semibold text-slate-900 hover:text-indigo-700 hover:underline dark:text-white dark:hover:text-indigo-300">
                <span aria-hidden="true">{m.emoji}</span> {m.numero} · {m.titreCourt}
              </a>
              <BarreProgression portee="module" module={m.numero} libelle={`Progression dans le module ${m.numero}`} class="mt-3" />
              <p class="mt-3 text-sm text-slate-600 dark:text-slate-400">
                Examen :{' '}
                {m.examen ? (
                  <>
                    <span class="font-medium text-slate-800 data-[reussi=true]:text-emerald-700 dark:text-slate-200 dark:data-[reussi=true]:text-emerald-400" data-resultat-examen={m.numero}>
                      Pas encore tenté
                    </span>{' '}
                    · <a href={m.urlExamen} class="text-indigo-700 hover:underline dark:text-indigo-300">passer l’examen</a>
                  </>
                ) : (
                  <span>en préparation</span>
                )}
              </p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mt-12" aria-labelledby="badges-titre">
      <div class="flex items-baseline justify-between gap-4">
        <h2 id="badges-titre" class="text-xl font-bold text-slate-900 dark:text-white">Mes badges</h2>
        <p class="text-sm text-slate-600 dark:text-slate-400">Obtenus : <span class="font-semibold" data-compteur-badges>0</span></p>
      </div>
      <h3 class="mt-6 text-sm font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Badges de parcours</h3>
      <ul class="mt-3 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5" data-badges="global" data-testid="badges-globaux">
        <li class="col-span-full text-sm text-slate-500">Chargement des badges…</li>
      </ul>
      <h3 class="mt-8 text-sm font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Badges de module (examen réussi)</h3>
      <ul class="mt-3 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4" data-badges="module" data-testid="badges-modules">
        <li class="col-span-full text-sm text-slate-500">Chargement des badges…</li>
      </ul>
    </section>

    <section class="mt-12 rounded-2xl border border-rose-200 p-6 dark:border-rose-900" aria-labelledby="reset-titre">
      <h2 id="reset-titre" class="text-lg font-bold text-slate-900 dark:text-white">Recommencer à zéro</h2>
      <p class="mt-2 text-slate-600 dark:text-slate-400">Efface les leçons terminées, les scores des quiz et des examens, et les badges. Action définitive.</p>
      <button type="button" class="bouton bouton-secondaire mt-4 border-rose-400! text-rose-700! dark:text-rose-300!" data-reinitialiser data-testid="progression-reset">
        Réinitialiser ma progression
      </button>
    </section>
  </main>
</BaseLayout>
